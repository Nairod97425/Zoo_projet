{% extends 'base.html.twig' %}

{% block title %}Liste des habitats
{% endblock %}

{% block body %}
	<h1>Liste des habitats</h1>
	{# Bouton "Ajouter un habitat" accessible uniquement aux ROLE_ADMIN ou ROLE_EMPLOYE #}
    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_EMPLOYE') %}
        <a href="{{ path('habitat_new') }}" class="btn btn-primary mb-3">Ajouter un habitat</a>
    {% endif %}
	<table class="table">
		<thead>
			<tr>
				<th>ID</th>
				<th>Nom</th>
				<th>Description</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			{% for image in habitat.images %}
				<img src="{{ asset('uploads/' ~ image) }}" alt="Image de l'habitat">
			{% endfor %}

			{% for habitat in habitats %}
				<tr>
					<td>{{ habitat.id }}</td>
					<td>{{ habitat.name }}</td>
					<td>{{ habitat.description }}</td>
					
					<td>
						{# Bouton "Modifier" accessible uniquement aux ROLE_ADMIN ou ROLE_EMPLOYE #}
                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_EMPLOYE') %}
                            <a href="{{ path('habitat_edit', {'id': habitat.id}) }}" class="btn btn-warning">Modifier</a>
                        {% endif %}

                        {# Bouton "Supprimer" accessible uniquement aux ROLE_ADMIN ou ROLE_EMPLOYE #}
                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_EMPLOYE') %}
                            <form method="post" action="{{ path('habitat_delete', {'id': habitat.id}) }}" style="display:inline-block;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ habitat.id) }}">
                                <button class="btn btn-danger">Supprimer</button>
                            </form>
                        {% endif %}
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endblock %}
