{% extends 'base.html.twig' %}

{% block title %}Liste des Habitats{% endblock %}

{% block body %}
    <div class="container">
        <h1>Liste des Habitats</h1>

        {# Bouton "Ajouter un habitat" accessible uniquement aux ROLE_ADMIN ou ROLE_EMPLOYE #}
        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_EMPLOYE') %}
            <a href="{{ path('habitat_new') }}" class="btn btn-primary mb-3">Ajouter un Habitat</a>
        {% endif %}

        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Images</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for habitat in habitats %}
                    <tr>
                        <td>{{ habitat.id }}</td>
                        <td>{{ habitat.name }}</td>
                        <td>{{ habitat.description }}</td>
                        <td>
                            {# Affichage des images de l'habitat #}
                            {% for image in habitat.images %}
                                <img src="{{ asset('uploads/' ~ image) }}" alt="Image de l'Habitat" style="width: 100px; height: auto; margin-right: 5px;">
                            {% endfor %}
                        </td>
                        <td>
                            {# Bouton "Modifier" accessible uniquement aux ROLE_ADMIN ou ROLE_EMPLOYE #}
                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_EMPLOYE') %}
                                <a href="{{ path('habitat_edit', {'id': habitat.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                            {% endif %}

                            {# Bouton "Supprimer" accessible uniquement aux ROLE_ADMIN ou ROLE_EMPLOYE #}
                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_EMPLOYE') %}
                                <form method="post" action="{{ path('habitat_delete', {'id': habitat.id}) }}" style="display:inline-block;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ habitat.id) }}">
                                    <button class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet habitat ?');">Supprimer</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">Aucun habitat trouvé</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}