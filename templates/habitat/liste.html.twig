{# templates/habitat/liste.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Liste des habitats
{% endblock %}

{% block body %}
	<h1>Liste des habitats</h1>

	<ul>
		{% for habitat in habitats %}
			<li>
				<strong>{{ habitat.name }}</strong>

				{% for image in habitat.images %}
					<img src="{{ asset('uploads/images/' ~ image) }}" alt="{{ habitat.name }}">
				{% endfor %}

				<p>{{ habitat.description }}</p>

				{# Lien vers la page des détails de l'habitat et des animaux #}
				<a href="{{ path('habitat_show', {'id': habitat.id}) }}">Voir les animaux de cet habitat</a>

				{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_EMPLOYE') %}
					<a href="{{ path('habitat_edit', {id: habitat.getId()}) }}">Modifier</a>
					<form action="{{ path('habitat_delete', {id: habitat.getId()}) }}" method="POST" style="display:inline;">
						<button type="submit" class="btn btn-danger">Supprimer</button>
					</form>
				{% endif %}
			</li>
		{% endfor %}
	</ul>

	{# Bouton "Ajouter un habitat" accessible uniquement aux ROLE_ADMIN ou ROLE_EMPLOYE #}
	{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_EMPLOYE') %}
		<a href="{{ path('habitat_new') }}" class="btn btn-primary mb-3">Ajouter un habitat</a>
	{% endif %}
{% endblock %}
