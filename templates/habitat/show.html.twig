{% extends 'base.html.twig' %}

{% block title %}Détails de l'Habitat{% endblock %}

{% block body %}
    <div class="container">
        <h1>Habitat: {{ habitat.name }}</h1>
        <p>{{ habitat.description }}</p>

        <h2>Animaux présents dans cet habitat :</h2>
        {% if animals is empty %}
            <p>Aucun animal n'a été ajouté à cet habitat.</p>
        {% else %}
            <ul class="list-unstyled">
            {% for animal in animals %}
                <li class="mb-4">
                    <strong>{{ animal.name }}</strong> ({{ animal.species }})
                    
                    {# Affichage de l'image de l'animal si elle existe #}
                    {% if animal.image %}
                        <img src="{{ asset('uploads/images/' ~ animal.image) }}" alt="{{ animal.name }}" style="max-width: 150px; height: auto; margin-right: 10px;">
                    {% else %}
                        <p>Aucune image disponible</p>
                    {% endif %}

                    {# Affichage de la description de l'animal si elle existe #}
                    {% if animal.description %}
                        <p>{{ animal.description }}</p>
                    {% else %}
                        <p>Aucune description disponible</p>
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_EMPLOYE') %}
                        <a href="{{ path('animal_edit', {'id': animal.id}) }}" class="btn btn-warning btn-sm">Éditer</a>
                        <form action="{{ path('animal_delete', {'id': animal.id}) }}" method="POST" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ animal.id) }}">
                            <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                        </form>
                    {% endif %}
                </li>
            {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}