{% extends 'base.html.twig' %}

{% block title %}Ajouter un Habitat{% endblock %}

{% block body %}
    <h1>Ajouter un Habitat</h1>

    {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.description) }}
        {{ form_row(form.images) }}
        {{ form_row(form.animals) }}
        <button class="btn btn-primary" type="submit">Enregistrer</button>
    {{ form_end(form) }}

    <br>
    <a href="{{ path('habitat_index') }}">Retour à la liste des habitats</a>
{% endblock %}
