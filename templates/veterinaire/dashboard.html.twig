{# templates/employe/dashboard.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Tableau de Bord Employé{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Bienvenue sur le Tableau de Bord Employé</h1>
        <p>Voici un aperçu des informations et des outils disponibles pour vous :</p>

        <!-- Contenu spécifique pour le tableau de bord de l'employé -->
        <div class="mb-4">
            <h2>Vos Tâches</h2>
            <p>Consultez vos tâches en cours et vos priorités.</p>
            <a href="{{ path('tasks_index') }}" class="btn btn-primary">Voir mes tâches</a>
        </div>

        <div class="mb-4">
            <h2>Rapports</h2>
            <p>Générez des rapports sur les activités du zoo.</p>
            <a href="{{ path('reports_index') }}" class="btn btn-success">Voir les rapports</a>
        </div>

        <div class="mb-4">
            <h2>Gestion des Animaux</h2>
            <p>Accédez aux informations sur les animaux et leur état de santé.</p>
            <a href="{{ path('animals_index') }}" class="btn btn-info">Gérer les animaux</a>
        </div>

        <div class="mb-4">
            <h2>Consultations de Santé</h2>
            <p>Consultez et gérez les consultations de santé des animaux.</p>
            <a href="{{ path('consultation_index') }}" class="btn btn-warning">Voir les consultations</a>
        </div>

        <div class="mb-4">
            <h2>Notifications</h2>
            <p>Consultez vos notifications et alertes.</p>
            <a href="{{ path('notifications_index') }}" class="btn btn-secondary">Voir les notifications</a>
        </div>
    </div>
{% endblock %}