{# templates/admin_animal/edit.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Modifier l'Animal{% endblock %}

{% block body %}
    <div class="container">
        <h1>Modifier l'Animal</h1>

        {# Afficher les erreurs de formulaire si elles existent #}
        {% if app.session.flashbag.has('error') %}
            <div class="alert alert-danger">
                {% for message in app.session.flashbag.get('error') %}
                    <p>{{ message }}</p>
                {% endfor %}
            </div>
        {% endif %}

        {{ form_start(form) }}
            {{ form_row(form.name) }}
            {{ form_row(form.species) }}
            {{ form_row(form.birthDate) }}
            {{ form_row(form.healthStatus) }}
            {{ form_row(form.feedingSchedule) }}
            {{ form_row(form.habitat) }}
            {{ form_row(form.description) }}
            {{ form_row(form.image) }}

            <button type="submit" class="btn btn-primary">Mettre à jour l'Animal</button>
        {{ form_end(form) }}
    </div>
{% endblock %}