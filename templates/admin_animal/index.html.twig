{# templates/admin_animal/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Liste des Animaux{% endblock %}

{% block body %}
    <div class="container">
        <h1>Liste des Animaux</h1>

        <a href="{{ path('animal_new') }}" class="btn btn-primary mb-3">Ajouter un Nouvel Animal</a>

        <table class="table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Espèce</th>
                    <th>Date de Naissance</th>
                    <th>État de Santé</th>
                    <th>Horaire de Nourriture</th>
                    <th>Habitat</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for animal in animals %}
                    <tr>
                        <td>{{ animal.name }}</td>
                        <td>{{ animal.species }}</td>
                        <td>{{ animal.birthDate|date('d/m/Y') }}</td>
                        <td>{{ animal.healthStatus }}</td>
                        <td>{{ animal.feedingSchedule }}</td>
                        <td>{{ animal.habitat ? animal.habitat.name : 'Aucun habitat' }}</td>
                        <td>
                            <a href="{{ path('animal_edit', {'id': animal.id}) }}" class="btn btn-warning btn-sm">Modifier</a>

                            {# Formulaire pour supprimer un animal #}
                            <form action="{{ path('animal_delete', {'id': animal.id}) }}" method="post" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ animal.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet animal ?');">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7">Aucun animal trouvé</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}