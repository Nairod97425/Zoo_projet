{# templates/admin/manage_habitats.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Gérer les Habitats
{% endblock %}

{% block body %}
	<div class="container">
		<h1>Gérer les Habitats</h1>
		<a href="{{ path('admin_create_habitat') }}" class="btn btn-primary mb-3">Créer un nouvel habitat</a>
		<table class="table">
			<thead>
				<tr>
					<th>ID</th>
					<th>Nom</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for image in habitat.images %}
					<img src="{{ asset('uploads/' ~ image) }}" alt="Image de l'habitat">
				{% endfor %}

				{% for habitat in habitats %}
					<tr>
						<td>{{ habitat.id }}</td>
						<td>{{ habitat.nom }}</td>
                        <td>{{ habitat.description }}</td>
						<td>
							<a href="{{ path('admin_edit_habitat', { id: habitat.id }) }}" class="btn btn-warning btn-sm">Modifier</a>
							<form method="post" action="{{ path('admin_delete_habitat', { id: habitat.id }) }}">
								<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ habitat.id) }}">
								<button class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr ?');">Supprimer</button>
							</form>

						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="3">Aucun habitat trouvé</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
{% endblock %}
