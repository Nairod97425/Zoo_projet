{# templates/registration/register.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
	<div class="text-center">
		<h1><strong>Inscription</strong></h1>

		{{ form_start(registrationForm) }}
		<div class="form-group">
			{{ form_label(registrationForm.email) }}
			{{ form_widget(registrationForm.email, {'attr': {'class': 'form-control custom-input'}}) }}
			{{ form_errors(registrationForm.email) }}
		</div>
		<div class="form-group">
			{{ form_label(registrationForm.plainPassword.first) }}
			{{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'form-control custom-input'}}) }}
			{{ form_errors(registrationForm.plainPassword.first) }}
		</div>
		<div class="form-group">
			{{ form_label(registrationForm.plainPassword.second) }}
			{{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'form-control custom-input'}}) }}
			{{ form_errors(registrationForm.plainPassword.second) }}
		</div>
		<div class="form-group">
			{{ form_label(registrationForm.pseudo) }}
			{{ form_widget(registrationForm.pseudo, {'attr': {'class': 'form-control custom-input'}}) }}
			{{ form_errors(registrationForm.pseudo) }}
		</div>
		<div class="form-group">
			{{ form_widget(registrationForm.submit, {'attr': {'class': 'btn btn-primary'}}) }}
		</div>
		{{ form_end(registrationForm) }}
	</div>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		.custom-input {
			width: 50%;
		}
		.form-group {
			margin-bottom: 1rem;
			display: flex;
			flex-direction: column;
			align-items: center;
		}
		h1 {
			margin-bottom: 1rem;
			font-family: sans-serif;
		}
	</style>
{% endblock %}
