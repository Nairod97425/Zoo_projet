{% extends 'base.html.twig' %}

{% block title %}Liste des Consultations{% endblock %}

{% block body %}
    <div class="container">
        <h1>Liste des Consultations</h1>

        <table class="table">
            <thead>
                <tr>
                    <th>Animal</th>
                    <th>Habitat</th>
                    <th>Date</th>
                    <th>Nombre de Consultations</th>
                    <th>État de Santé</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for consultation in consultations %}
                    <tr>
                        <td>{{ consultation.animal.name }}</td>
                        <td>{{ consultation.habitat.name }}</td>
                        <td>{{ consultation.date|date('Y-m-d') }}</td>
                        <td>{{ consultation.nombre_de_consultation }}</td>
                        <td>{{ consultation.healthStatus }}</td>
                        <td>
                            <a href="{{ path('consultation_edit', {id: consultation.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                            <form action="{{ path('consultation_delete', {id: consultation.id}) }}" method="post" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ consultation.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette consultation ?');">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">Aucune consultation trouvée</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <a href="{{ path('consultation_new') }}" class="btn btn-primary">Ajouter une Nouvelle Consultation</a>
    </div>
{% endblock %}