{% extends 'base.html.twig' %}
{# templates/avis/index.html.twig #}

{% block title %}Liste des Avis
{% endblock %}

{% block body %}
	<div class="container">
		<h1>Avis des Utilisateurs</h1>
		<ul>
			{% for avis in avis %}
				<li>{{ avis.pseudo }}:
					{{ avis.avis }}
					({{ avis.statut ? 'Approuvé' : 'En attente' }}) -
					{{ avis.habitat }}</li>
			{% endfor %}
		</ul>
		<a href="{{ path('avis_new') }}">Ajouter un avis</a>
	</div>
{% endblock %}
