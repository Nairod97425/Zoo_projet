{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="container mt-4 d-flex flex-column align-items-center">
    <h1 class="mb-4">Connexion</h1>

    {% if error %}
        <div class="alert alert-danger w-50">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="POST" action="{{ path('app_login') }}" class="w-50">
        <div class="form-group">
            <input type="text" name="_email" placeholder="Email" class="form-control mb-3" required>
        </div>
        <div class="form-group">
            <input type="password" name="_password" placeholder="Mot de passe" class="form-control mb-3" required>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="btn btn-primary w-50">Se connecter</button>
    </form>

    <div class="mt-4">
        <a href="{{ path('app_register') }}">Pas encore inscrit ? Créez un compte ici.</a>
    </div>
</div>
{% endblock %}
